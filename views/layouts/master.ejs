<div class="panel" id="pb-AdminPanel">
<div class="header">
    <h2>Admin Panel</h2>
    <span class="muted">Warning: Not live</span>
</div>
<h3>Key Creation</h3>
<div class="list">
    <label class="pb-text-label">
		Name:
		<input placeholder="Cool Key" title="Key Name" class="marbot" type="text" id="pb-kc-keyName">
    </label>
    <label class="pb-text-label">
		Key:
		<input placeholder="At least 8 characters" title="Key" class="marbot" type="password" id="pb-kc-ncinp">
		<input placeholder="Confirm Key" title="Confirm Key" class="marbot" type="password" id="pb-kc-keyConfirm">
    </label>
    <label class="pb-text-label">
		Maximum Sessions:
		<input placeholder="Maximum Sessions" id="pb-kc-maxinp" type="number" title="Maximum concurrent sessions or usage" value="1" class="marbot" min="1">
    </label>
	<label class="marbot toggle-row" title="Limit the amount times this key can be used to log in.">
        <span class="toggle-label">Limit Usage</span>
        <label class="toggle">
            <input type="checkbox" id="pb-kc-limit" checked/>
            <div class="toggle-track"></div>
        </label>
    </label>
    <label class="marbot toggle-row" title="Give user access to admin panel (Dangerous)">
        <span class="toggle-label">Administrator Access</span>
        <label class="toggle">
            <input type="checkbox" id="pb-kc-master"/>
            <div class="toggle-track"></div>
        </label>
    </label>
    <button id="pb-kc-submit">Create</button>
</div>
<hr>
<h3>Ongoing Sessions (<%= sessions.size %>)</h3>
<div class="list" id="pb-sessionlist">
    <% for(let [id, sessionObj] of sessions.entries()){ %> 
        <div class="item marbot">
            [<%= id.toString() %>]
            [<%= sessionObj.key %>]
            <%= id==sessionID ? " [YOU]" : "" %> 
            <div class="timeComponent" data-expiry-time="<%= sessionObj.expiryTime %>" title="Expires in...">Loading...</div>
            <button class="pb-sessionend" value="<%= id.toString() %>">END </button>
        </div>
    <% } %>
</div>
<hr/>
<h3>Valid Keys (<%= keys.size %>)</h3>
<div class="list" id="pb-keylist">
    <% for(let [keyName, keyObj] of keys.entries()){ %>
        <% if(keyObj){ %> 
            <div class="item marbot">
                <span>
                [<%= keyName %>]
                <%= keyName==sessions.get(sessionID).key ? " [YOU]" : "" %> 
                <br/>
                <%= keyObj.usage.toString() %>/<%= keyObj.maxsession.toString() %> <%= keyObj.unlimit ? "Sessions" : "Uses" %> 
                </span>
				<% if(keyObj.master){ %>
                    <span class="icon-admin" title="This user is an admin."></span>
                <% } %>
                <button class="pb-keyinvalid" value="<%= keyName.toString() %>">INVALIDATE </button>
            </div>
        <% } %>
    <% } %>
</div>
</div>