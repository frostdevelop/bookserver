<div class="panel" id="pb-AdminPanel">
<h2 class="header">Admin Panel</h2>
<h3>Key Creation</h3>
<div class="list">
    <label class="pb-text-label">
		Name:
		<input placeholder="Unnamed" title="Key Name" class="marbot" type="text" id="pb-kc-keyName">
    </label>
    <label class="pb-text-label">
		Key:
		<input placeholder="e.g. 12345" title="Key" class="marbot" type="password" id="pb-kc-ncinp">
    </label>
    <label class="pb-text-label">
		Maximum Sessions:
		<input placeholder="Maximum Sessions" id="pb-kc-maxinp" type="number" title="Maximum Sessions" value="1" class="marbot" min="1">
    </label>
	<label class="marbot toggle-row" title="Limit the amount of logins by the above number">
        <span class="toggle-label">Limited</span>
        <label class="toggle">
            <input type="checkbox" id="pb-kc-limit" checked/>
            <div class="toggle-track"></div>
        </label>
    </label>
    <label class="marbot toggle-row" title="Give user access to admin panel (Dangerous)">
        <span class="toggle-label">Master</span>
        <label class="toggle">
            <input type="checkbox" id="pb-kc-master"/>
            <div class="toggle-track"></div>
        </label>
    </label>
    <button id="pb-kc-submit">Create</button>
</div>
<hr>
<h3>Ongoing Sessions</h3>
<div class="list" id="pb-sessionlist">
    <% for(let i=0;i<sessions.length;i++){ %> 
        <div class="item marbot">
            <%= keys[sessions[i].key].name %>:<%= sessions[i].id.toString() %>
			| <%= keys[sessions[i].key].master ? "MASTER" : "GUEST" %>
            | EXPIRY: <%= ((sessions[i].expiryTime - Date.now())/60000).toFixed(1) %> min
            <%= i==sessionIndex ? " [YOU]" : "" %> 
            <button class="pb-sessionend" value="<%= sessions[i].key.toString() %>:<%= sessions[i].id.toString() %>">END </button>
        </div>
    <% } %>
</div>
<hr/>
<h3>Valid Keys</h3>
<div class="list" id="pb-keylist">
    <% for(let i=0;i<keys.length;i++){ %>
        <% if(keys[i]){ %> 
            <div class="item marbot">
                [<%= keys[i].name %>]
				<%= keys[i].master ? "MASTER" : "GUEST" %>
                | ACTIVE:<%= keys[i].usage.toString() %> 
                | MAX:<%= keys[i].maxsession.toString() %>
                | <%= keys[i].unlimit ? "UNLIM" : "LIMTD" %>
                <%= i==sessions[sessionIndex].key ? " [YOU]" : "" %> 
                <button class="pb-keyinvalid" value="<%= i.toString() %>">INVALIDATE </button>
            </div>
        <% } %>
    <% } %>
</div>
</div>