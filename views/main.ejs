<!DOCTYPE html><html lang="en"><head><title>Pacific Book Database</title><%- include('layouts/meta', {mir:mir}) -%><script>var frostMir = '<%= mir %>';</script></head><% if(verified){ %> <body><h1>Pacific Book Database</h1><span id="caption">Welcome to the Pacific book database portal</span><% if(master){ %> <%- include('layouts/master') -%> <% } %><button id="pb-logoutbtn" class="marright">Log Out</button><button id="pb-reloadbtn" class="marright">Refresh</button><hr/><% for(let i=0;i<library.length;i++){ %><h2><%= library[i].name %></h2><div class="list"><% for(let j=0;j<library[i].books.length;j++){ %><div class="book"><a href="/content/<%= library[i].path %>/<%= library[i].books[j] %>"><%= library[i].books[j] %></a></div><% } %></div><hr/><% } %><%- include('layouts/footer', {mir:mir}) -%><script>const lgoutbtn = document.getElementById("pb-logoutbtn");const reldbtn = document.getElementById("pb-reloadbtn");lgoutbtn.addEventListener("click",()=>{fetch(frostMir+"/session", {method: "DELETE"}).then(res=>{if(res.status==204){window.location.reload();}else{alert("Request Error "+res.status.toString());};});});reldbtn.addEventListener("click",()=>{fetch(frostMir+"/reload", {method: "HEAD"}).then(res=>{if(res.status==204){window.location.reload();}else{alert("Request Error "+res.status.toString());};});});</script><% if(master){ %> <script src="<%= mir %>/js/master.js"></script> <% } %></body> <% }else{ %> <body class="mainback"><div class="logincontainer"><h1>Pacific Book Database</h1><span id="caption">Please Authenticate.</span><div class="login"><h3>Login</h3><input id="keyinput" placeholder="Your Key" type="password"></input><button id="keylogin">Login</button><hr/><h3>Request a key</h3><input id="reqinput" type="text" placeholder="Message"></input><button id="reqkey">Request Key</button></div><%- include('layouts/footer', {mir:mir}) -%></div><script>const loginbtn = document.getElementById("keylogin");const logininp = document.getElementById("keyinput");const reqbtn = document.getElementById("reqkey");const reqinput = document.getElementById("reqinput");async function hash(msg){const encoder = new TextEncoder();return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', encoder.encode(msg)))).map(b => b.toString(16).padStart(2, '0')).join('');};reqbtn.addEventListener("click",()=>{fetch(frostMir+"/request",{method: "POST",headers: {"Content-Type": "application/json"},body: JSON.stringify({msg: reqinput.value})}).then(res=>{if(res.status == 204){alert("Message sent!");}else{alert("Error: "+res.status.toString());};});});loginbtn.addEventListener("click",async ()=>{fetch(frostMir+"/session", {method: "POST",headers: {"Content-Type": "application/json"},body: JSON.stringify({key: await hash(logininp.value)})}).then(res=>{if(res.status==204){window.location.reload();}else{alert("Invalid KEY!");};});});</script></body> <% } %></html>