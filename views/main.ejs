<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Pacific Book Database</title>
        <%- include('layouts/meta', {mir:mir}) -%>
        <script>var frostMir = '<%= mir %>';</script>
    </head>
    <% if(verified){ %> 
        <body>
            <% if(master){ %> <%- include('layouts/master') -%> <% } %>
            <div id="pb-actionContainer">
                <button id="pb-logoutbtn" class="marright">Log Out</button>
                <button id="pb-reloadbtn" class="marright">Refresh</button>
            </div>
            <div class="alertMsg">
                <div class="alertMsg_Msg"></div>
            </div>
            <main>
                <div class="contentContainer">
                    <h1>Pacific Book Database</h1>
                    <span id="caption">Welcome to the Pacific book database portal</span>
                    <% for(const [name,shelf] of library){ %>
                        <h2><%= name %></h2>
                        <hr/>
                        <div class="list">
                            <% for(let j=0;j<shelf.books.length;j++){ %>
                                <div class="book">
                                    <a href="/content/<%= name %>/<%= shelf.books[j] %>"><%= shelf.books[j] %></a>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                    <%- include('layouts/footer', {mir:mir}) -%>
                </div>
            </main>
            <script>
                const lgoutbtn = document.getElementById("pb-logoutbtn");
                const reldbtn = document.getElementById("pb-reloadbtn");
                lgoutbtn.addEventListener("click", () => {
                    fetch(frostMir + "/session", {
                        method: "DELETE"
                    }).then(res => {
                        if (res.status == 204) {
                            window.location.reload();
                        } else {
                            alert("Request Error " + res.status.toString());
                        };
                    });
                });
                reldbtn.addEventListener("click", () => {
                    fetch(frostMir + "/reload", {
                        method: "HEAD"
                    }).then(res => {
                        if (res.status == 204) {
                            window.location.reload();
                        } else {
                            alert("Request Error " + res.status.toString());
                        };
                    });
                });
            </script>
            <script src="<%= mir %>/js/timeComponent.js"></script>
            <% if(master){ %> 
            <script src="<%= mir %>/js/master.js"></script> 
            <% } %>
        </body> 
    <% }else{ %> 
        <body>
            <% if(loggedOut){ %>
                <div class="alertMsg visible">
                    <div class="alertMsg_Msg">You have been logged out.</div>
                </div>
            <% }else{ %>
                <div class="alertMsg">
                    <div class="alertMsg_Msg"></div>
                </div>
            <% } %>
            <main class="centered">
                <div class="contentContainer">
                    <h1>Pacific Book Database</h1>
                    <span id="caption">Please Authenticate.</span>
                    <div class="login panel">
                        <h3>Login</h3>
                        <div class="inputset">
                            <input id="keyinput" placeholder="Your Key" type="password"></input>
                            <button id="keylogin">Login</button>
                        </div>
                        <hr/>
                        <h3>Request a key</h3>
                        <div class="inputset">
                            <input id="reqinput" type="text" placeholder="Message"></input>
                            <button id="reqkey">Request Key</button>
                        </div>
                    </div>
                    <%- include('layouts/footer', {mir:mir}) -%>
                </div>
            </main>
            <script>
                const loginbtn = document.getElementById("keylogin");
                const logininp = document.getElementById("keyinput");
                const reqbtn = document.getElementById("reqkey");
                const reqinput = document.getElementById("reqinput");

                function showAlert(msg){
                    const alert = document.getElementsByClassName("alertMsg")[0];
                    alert.classList.add("visible");
                    alert.getElementsByClassName("alertMsg_Msg")[0].innerText = msg;
                    alert.addEventListener("click", () => {
                        alert.classList.remove("visible");
                    });
                    setTimeout(() => {
                        alert.classList.remove("visible");
                    }, 10000);
                }

                async function hash(msg) {
                    const encoder = new TextEncoder();
                    return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', encoder.encode(msg)))).map(b => b.toString(16).padStart(2, '0')).join('');
                }

                reqbtn.addEventListener("click", () => {
                    if(reqinput.value.length < 1){
                        showAlert("Please enter a message!");
                        return;
                    }
                    fetch(frostMir + "/request", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            msg: reqinput.value
                        })
                    }).then(res => {
                        if (res.status == 204) {
                            showAlert("Message sent!");
                        } else {
                            showAlert("Error: " + res.status.toString());
                        };
                    });
                });
                loginbtn.addEventListener("click", async () => {
                    fetch(frostMir + "/session", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            key: await hash(logininp.value)
                        })
                    }).then(res => {
                        if (res.status == 204) {
                            window.location.reload();
                        } else {
                            showAlert("Your key is invalid or expired. Please try again.");
                        };
                    });
                });
            </script>
        </body>
    <% } %>
</html>